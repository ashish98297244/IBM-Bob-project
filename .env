# ============================================================
# AI-Powered LaTeX Diagram Generator — Environment Variables
# IBM Watson Studio + IBM Granite Models
# ============================================================
# Copy this file to .env and fill in your credentials.
# ============================================================

# --- IBM Watson Studio / WatsonX Credentials (REQUIRED) ---
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Model Configuration ---
# Default model (change to any WatsonX-supported model ID)
GRANITE_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# Other available models:
#   ibm/granite-13b-instruct-v2
#   ibm/granite-20b-multilingual
#   ibm/granite-34b-code-instruct
#   ibm/granite-3-8b-instruct

# --- Model Inference Parameters ---
GRANITE_MAX_NEW_TOKENS=2048
GRANITE_MIN_NEW_TOKENS=50
GRANITE_TEMPERATURE=0.2
GRANITE_TOP_P=0.9
GRANITE_TOP_K=50
GRANITE_REPETITION_PENALTY=1.1

# --- Application Settings ---
APP_ENV=development
APP_LOG_LEVEL=INFO
OUTPUT_DIR=outputs
MAX_REFINEMENT_ITERATIONS=10
ENABLE_LATEX_VALIDATION=true

# --- LaTeX Compilation (optional, for local PDF preview) ---
# Set to true only if pdflatex is installed on your system
ENABLE_LOCAL_COMPILATION=false
LATEX_COMPILER=pdflatex
LATEX_TEMP_DIR=outputs/temp
